# Personal Finance OS — Production Environment
# Store this file on hermes at: ~/personal-finance-os/.env.production
# DO NOT commit this to git
# Secrets from 1Password

NODE_ENV=production
PORT=3000
DATABASE_URL=sqlite:////app/data/database.sqlite

# Plaid Configuration (get from 1Password)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Switch to production once you've tested thoroughly

# Anthropic Configuration (get from 1Password)
ANTHROPIC_API_KEY=

# Reverse proxy settings
API_TRUST_PROXY=true
# CLOUDFRONT_DOMAIN=finance.your-domain.com
