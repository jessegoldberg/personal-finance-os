{
  "id": "YfgbiKe1DxR7YY1E",
  "name": "Plaid Transactions Sync",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "e5f5a1c0-0001-4a00-8000-000000000001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://sandbox.plaid.com/transactions/sync",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"count\": 100 } }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "e5f5a1c0-0002-4a00-8000-000000000002",
      "name": "Transactions Sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "credentials": {
        "httpCustomAuth": {
          "id": "hO9micuSwF1NEC2T",
          "name": "Plaid Sandbox Item 1"
        }
      },
      "notesInFlow": true,
      "notes": "Auth headers (PLAID-CLIENT-ID/PLAID-SECRET) and the access_token body field are all injected by the 'Plaid Sandbox Item 1' Custom Auth credential. Both header AND body injection are CONFIRMED working on this n8n version (v2.23.3) as of first successful sync 2026-07-08. See docs/n8n-operations-runbook.md."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-sync-ok",
              "leftValue": "={{ $json.statusCode || 200 }}",
              "rightValue": 300,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "e5f5a1c0-0003-4a00-8000-000000000003",
      "name": "Sync OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "sum-status",
              "name": "status",
              "type": "string",
              "value": "ok"
            },
            {
              "id": "sum-synced-at",
              "name": "synced_at",
              "type": "string",
              "value": "={{ $now.toISO() }}"
            },
            {
              "id": "sum-added",
              "name": "transactions_added",
              "type": "number",
              "value": "={{ ($json.added || []).length }}"
            },
            {
              "id": "sum-modified",
              "name": "transactions_modified",
              "type": "number",
              "value": "={{ ($json.modified || []).length }}"
            },
            {
              "id": "sum-removed",
              "name": "transactions_removed",
              "type": "number",
              "value": "={{ ($json.removed || []).length }}"
            },
            {
              "id": "sum-has-more",
              "name": "has_more",
              "type": "boolean",
              "value": "={{ $json.has_more || false }}"
            },
            {
              "id": "sum-earliest",
              "name": "earliest_date",
              "type": "string",
              "value": "={{ (($json.added || []).map(t => t.date)).sort()[0] || '' }}"
            },
            {
              "id": "sum-latest",
              "name": "latest_date",
              "type": "string",
              "value": "={{ (($json.added || []).map(t => t.date)).sort().slice(-1)[0] || '' }}"
            },
            {
              "id": "sum-total",
              "name": "total_amount_abs",
              "type": "number",
              "value": "={{ Math.round((($json.added || []).reduce((s, t) => s + Math.abs(t.amount || 0), 0)) * 100) / 100 }}"
            }
          ]
        }
      },
      "id": "e5f5a1c0-0004-4a00-8000-000000000004",
      "name": "Redacted Summary (OK)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [900, 200],
      "notesInFlow": true,
      "notes": "Emits counts, date range, and an absolute-value total ONLY. Never the raw transaction rows, merchant names, or account ids."
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "err-status",
              "name": "status",
              "type": "string",
              "value": "error"
            },
            {
              "id": "err-synced-at",
              "name": "synced_at",
              "type": "string",
              "value": "={{ $now.toISO() }}"
            },
            {
              "id": "err-category",
              "name": "error_category",
              "type": "string",
              "value": "={{ $json.statusCode >= 500 ? 'plaid_server_error' : ($json.statusCode === 401 || $json.statusCode === 403 ? 'auth_error' : ($json.statusCode === 400 ? 'client_error_check_access_token' : 'client_error')) }}"
            }
          ]
        }
      },
      "id": "e5f5a1c0-0005-4a00-8000-000000000005",
      "name": "Redacted Summary (Error)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [900, 400]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Transactions Sync",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Transactions Sync": {
      "main": [
        [
          {
            "node": "Sync OK?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sync OK?": {
      "main": [
        [
          {
            "node": "Redacted Summary (OK)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Redacted Summary (Error)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": true
  },
  "staticData": null,
  "meta": {
    "description": "Sandbox-only. Calls Plaid /transactions/sync for the item held in the 'Plaid Sandbox Item 1' credential and emits a redacted summary (counts, date range, absolute total) — never raw transaction rows. Manual trigger, inactive by default. This is the first workflow that reads real account data shape; treat its output as sensitive even in sandbox.",
    "moneyMovement": false,
    "environment": "sandbox"
  }
}
