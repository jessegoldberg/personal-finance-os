{
  "id": "RGwhzm8SF3XCdlVJ",
  "name": "Plaid Sandbox Healthcheck",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "b1a1e6b0-0001-4a00-8000-000000000001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://sandbox.plaid.com/institutions/get",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"count\": 1, \"offset\": 0, \"country_codes\": [\"US\"] } }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "b1a1e6b0-0002-4a00-8000-000000000002",
      "name": "Plaid Institutions Get",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "credentials": {
        "httpCustomAuth": {
          "id": "PLAID_SANDBOX_CUSTOM_AUTH_CREDENTIAL_ID",
          "name": "Plaid Sandbox Custom Auth"
        }
      },
      "notesInFlow": true,
      "notes": "Auth is via the 'Plaid Sandbox Custom Auth' credential (Generic Credential Type -> Custom Auth), which injects PLAID-CLIENT-ID and PLAID-SECRET headers natively. This replaced an earlier body-based $credentials expression approach that was confirmed NOT to work (see docs/n8n-operations-runbook.md, 'Known quirk' section)."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-http-ok",
              "leftValue": "={{ $json.statusCode || 200 }}",
              "rightValue": 300,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "b1a1e6b0-0003-4a00-8000-000000000003",
      "name": "Response OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "sum-status",
              "name": "status",
              "type": "string",
              "value": "ok"
            },
            {
              "id": "sum-checked-at",
              "name": "checked_at",
              "type": "string",
              "value": "={{ $now.toISO() }}"
            },
            {
              "id": "sum-institutions-returned",
              "name": "institutions_returned",
              "type": "number",
              "value": "={{ ($json.institutions || []).length }}"
            }
          ]
        }
      },
      "id": "b1a1e6b0-0004-4a00-8000-000000000004",
      "name": "Redacted Summary (OK)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [900, 200]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "err-status",
              "name": "status",
              "type": "string",
              "value": "error"
            },
            {
              "id": "err-checked-at",
              "name": "checked_at",
              "type": "string",
              "value": "={{ $now.toISO() }}"
            },
            {
              "id": "err-category",
              "name": "error_category",
              "type": "string",
              "value": "={{ $json.statusCode >= 500 ? 'plaid_server_error' : ($json.statusCode === 401 || $json.statusCode === 403 ? 'auth_error' : 'client_error') }}"
            }
          ]
        }
      },
      "id": "b1a1e6b0-0005-4a00-8000-000000000005",
      "name": "Redacted Summary (Error)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [900, 400]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Plaid Institutions Get",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Plaid Institutions Get": {
      "main": [
        [
          {
            "node": "Response OK?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Response OK?": {
      "main": [
        [
          {
            "node": "Redacted Summary (OK)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Redacted Summary (Error)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": true
  },
  "staticData": null,
  "meta": {
    "description": "Sandbox-only healthcheck. Calls Plaid /institutions/get (read-only, no test item required) to confirm connectivity and credential wiring. Emits a redacted summary only — never the raw Plaid response. Must stay inactive until a human reviews a manual test run.",
    "moneyMovement": false,
    "environment": "sandbox"
  }
}
