# Plaid Configuration
PLAID_CLIENT_ID=your_sandbox_client_id
PLAID_SECRET=your_sandbox_secret
PLAID_ENV=sandbox
# Switch to production when ready:
# PLAID_ENV=production

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional: home value estimate + comps (free tier at rentcast.io)
RENTCAST_API_KEY=

# Backend Configuration
NODE_ENV=development
PORT=3000
DATABASE_URL=sqlite://./database.sqlite

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:3000

# Optional: If deploying behind a reverse proxy
# API_TRUST_PROXY=true
# CLOUDFRONT_DOMAIN=finance.your-domain.com

# Optional local model (Ollama on your network). Used only for features where you pick "local";
# never a fallback for Claude. Install the model on the Ollama server yourself — this app never downloads models.
LOCAL_LLM_PROVIDER=none            # set to: ollama
LOCAL_LLM_BASE_URL=                # e.g. http://192.168.60.20:11434
LOCAL_LLM_MODEL=                   # e.g. qwen2.5:7b
LOCAL_LLM_TIMEOUT_MS=120000
LOCAL_LLM_MAX_TOKENS=192
LOCAL_LLM_NUM_CTX=2048
LOCAL_LLM_KEEP_ALIVE=0             # 0 unloads the model after each request (shared 16 GB server); e.g. 5m keeps it warm
LOCAL_LLM_MAX_QUEUE=2
